{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "localDevelopment",
    "webService",
    "services"
  ],
  "properties": {
    "localDevelopment": {
      "type": "boolean"
    },
    "hostnames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tlsSecretName": {
      "type": "string"
    },
    "webService": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authService",
        "accountsService",
        "virtualMoney",
        "pokerService",
        "cryptoService"
      ],
      "properties": {
        "authService": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "accountsService": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "virtualMoney": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "pokerService": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "cryptoService": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "localDevelopment": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "tlsSecretName": {
            "minLength": 1
          },
          "hostnames": {
            "minItems": 1
          },
          "traefik": {
            "properties": {
              "image": {
                "properties": {
                  "digest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "digest"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "localDevelopment": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "traefik": {
            "properties": {
              "image": {
                "anyOf": [
                  {
                    "properties": {
                      "tag": {
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "digest": {
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "digest"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
